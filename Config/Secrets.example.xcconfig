// Copy this file to Secrets.xcconfig (same folder) and fill in your values.
// Secrets.xcconfig is in .gitignore, so it never goes to GitHub.
// Values from Supabase › Project Settings › API Keys / Data API:
//   project id = the part before .supabase.co in the Project URL
//   key        = the Publishable key (sb_publishable_…), NEVER the secret one
SUPABASE_PROJECT = your-project-id
SUPABASE_KEY = sb_publishable_your-key
